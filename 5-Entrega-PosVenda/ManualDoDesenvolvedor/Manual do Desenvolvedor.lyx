\begin_layout Subsection
Descrição das Classes Principais
\end_layout

\begin_layout Itemize

\family typewriter
CSimulador
\family default
:
 A classe central que gerencia o fluxo da aplicação.
 É responsável por exibir o menu,
 processar a entrada do usuário e coordenar as ações entre as outras classes.
 
\end_layout

\begin_layout Itemize

\family typewriter
CReservoirData
\family default
:
 Container de dados que armazena e gerencia a lista de todas as amostras carregadas na sessão.
 
\end_layout

\begin_layout Itemize

\family typewriter
CAmostra
\family default
:
 Modela uma única amostra de rocha,
 contendo suas propriedades como nome,
 profundidade,
 porosidade e a composição mineralógica.
 
\end_layout

\begin_layout Itemize

\family typewriter
CMineralDatabase
\family default
:
 Responsável por carregar e fornecer acesso aos dados elásticos dos minerais a partir do arquivo 
\family typewriter
minerais.csv
\family default
.
 
\end_layout

\begin_layout Itemize

\family typewriter
CMineral
\family default
:
 Representa um mineral individual com seus módulos K e G.
 
\end_layout

\begin_layout Itemize

\family typewriter
CPlotManager
\family default
:
 Encapsula toda a lógica para a geração de gráficos.
 Interage com o 
\family typewriter
gnuplot
\family default
 para criar scripts,
 salvar os gráficos em arquivos 
\family typewriter
.png
\family default
 e exibi-los na tela.
 
\end_layout

\begin_layout Itemize

\family typewriter
CElasticCalculator
\family default
:
 Classe (e suas derivadas 
\family typewriter
CBulkCalculator
\family default
,
 
\family typewriter
CShearCalculator
\family default
) que contém a lógica matemática para calcular os módulos elásticos efetivos usando as médias de Voigt,
 Reuss e Hill.
 
\end_layout

