\begin_layout Plain Layout


\backslash
subsection*{Versão 1.0 - Núcleo de Cálculo Poroelástico}
\end_layout

\begin_layout Plain Layout


\backslash
begin{itemize}
\end_layout

\begin_layout Plain Layout

    
\backslash
item 
\backslash
textbf{Cálculo dos Módulos Elásticos:} O sistema deve ser capaz de calcular os módulos de compressibilidade (K) e de cisalhamento (G) efetivos de um compósito mineral utilizando as médias de Voigt,
 Reuss e Hill.
\end_layout

\begin_layout Plain Layout

        
\backslash
subitem 
\backslash
textit{Classes implementadas:} 
\backslash
texttt{CElasticCalculator},
 
\backslash
texttt{CBulkCalculator},
 
\backslash
texttt{CShearCalculator}.
\end_layout

\begin_layout Plain Layout

    
\end_layout

\begin_layout Plain Layout

    
\backslash
item 
\backslash
textbf{Gerenciamento da Base de Dados de Minerais:} O sistema deve carregar e gerenciar uma base de dados de minerais a partir de um arquivo externo (
\backslash
texttt{.csv}),
 permitindo a consulta das propriedades elásticas de cada mineral pelo nome.
\end_layout

\begin_layout Plain Layout

        
\backslash
subitem 
\backslash
textit{Classe implementada:} 
\backslash
texttt{CMineralDatabase}.
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    
\backslash
item 
\backslash
textbf{Leitura de Arquivo de Entrada Simplificado:} O sistema deve ser capaz de ler um arquivo de texto com a definição de uma única amostra de rocha,
 incluindo sua composição mineralógica e porosidade.
\end_layout

\begin_layout Plain Layout

        
\backslash
subitem 
\backslash
textit{Classe implementada:} 
\backslash
texttt{CInput}.
\end_layout

\begin_layout Plain Layout

        
\end_layout

\begin_layout Plain Layout

    
\backslash
item 
\backslash
textbf{Visualização Gráfica:} O sistema deve gerar gráficos que correlacionem as propriedades elásticas calculadas com a variação da composição entre dois minerais.
\end_layout

\begin_layout Plain Layout

        
\backslash
subitem 
\backslash
textit{Classe implementada:} 
\backslash
texttt{CPlotManager}.
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    
\backslash
item 
\backslash
textbf{Orquestração Central:} O sistema deve possuir uma classe principal para coordenar o fluxo de execução,
 desde a leitura dos dados até a apresentação dos resultados.
\end_layout

\begin_layout Plain Layout

        
\backslash
subitem 
\backslash
textit{Classe implementada:} 
\backslash
texttt{CSimulador}.
\end_layout

\begin_layout Plain Layout


\backslash
end{itemize}
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout


\backslash
subsection*{Versão 2.0 - Arquitetura Refinada e Análise Multi-Amostra}
\end_layout

\begin_layout Plain Layout


\backslash
begin{itemize}
\end_layout

\begin_layout Plain Layout

    
\backslash
item 
\backslash
textbf{Abstração da Entidade Amostra:} Para aprimorar a coesão e o encapsulamento,
 o conceito de "amostra de rocha" foi abstraído em uma classe própria,
 responsável por conter todos os seus dados característicos.
\end_layout

\begin_layout Plain Layout

        
\backslash
subitem 
\backslash
textit{Classe implementada:} 
\backslash
texttt{CAmostra}.
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    
\backslash
item 
\backslash
textbf{Abstração da Entidade Mineral:} De forma análoga,
 a entidade "mineral" foi encapsulada em sua própria classe,
 refinando a estrutura da base de dados e tornando o código mais claro e orientado a objeto.
\end_layout

\begin_layout Plain Layout

        
\backslash
subitem 
\backslash
textit{Classe implementada:} 
\backslash
texttt{CMineral}.
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    
\backslash
item 
\backslash
textbf{Processamento de Múltiplas Amostras:} O sistema foi aprimorado para ler e processar arquivos de entrada contendo a definição de múltiplas amostras de diferentes profundidades e porosidades.
\end_layout

\begin_layout Plain Layout

        
\backslash
subitem 
\backslash
textit{Evolução da classe:} 
\backslash
texttt{CInput}.
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    
\backslash
item 
\backslash
textbf{Gerenciamento de Dados de Reservatório:} Foi introduzida uma classe para agregar e gerenciar o conjunto de todas as amostras processadas e seus respectivos resultados,
 facilitando a análise consolidada.
\end_layout

\begin_layout Plain Layout

        
\backslash
subitem 
\backslash
textit{Classe implementada:} 
\backslash
texttt{CReservoirData}.
\end_layout

\begin_layout Plain Layout

        
\end_layout

\begin_layout Plain Layout

    
\backslash
item 
\backslash
textbf{Geração de Perfis de Profundidade e Porosidade:} A capacidade de visualização foi expandida para permitir a plotagem de perfis contínuos,
 mostrando a variação dos módulos elásticos (K e G) em função da profundidade ou da porosidade para o conjunto de amostras analisadas.
\end_layout

\begin_layout Plain Layout

        
\backslash
subitem 
\backslash
textit{Evolução da classe:} 
\backslash
texttt{CPlotManager}.
\end_layout

\begin_layout Plain Layout


\backslash
end{itemize}
\end_layout

\begin_layout Plain Layout


\backslash
end{itemize}
