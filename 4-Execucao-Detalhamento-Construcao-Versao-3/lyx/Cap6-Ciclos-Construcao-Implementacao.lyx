void CMineralDatabase::LoadFromFile(const std::string& filePath) {
\end_layout

\begin_layout Plain Layout

    std::ifstream file(filePath);
\end_layout

\begin_layout Plain Layout

    if (!file.is_open()) {
\end_layout

\begin_layout Plain Layout

        std::cerr << "[ERRO] Nao foi possivel abrir o arquivo de minerais:
 " << filePath << "
\backslash
n";
\end_layout

\begin_layout Plain Layout

        return;
\end_layout

\begin_layout Plain Layout

    }
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    std::string linha;
\end_layout

\begin_layout Plain Layout

    bool headerPulado = false;
\end_layout

\begin_layout Plain Layout

    while (std::getline(file,
 linha)) {
\end_layout

\begin_layout Plain Layout

        if (!headerPulado) {
\end_layout

\begin_layout Plain Layout

            headerPulado = true;
\end_layout

\begin_layout Plain Layout

            continue;
\end_layout

\begin_layout Plain Layout

        }
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

        std::stringstream ss(linha);
\end_layout

\begin_layout Plain Layout

        std::string nome,
 kStr,
 gStr;
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

        if (std::getline(ss,
 nome,
 ',') &&
\end_layout

\begin_layout Plain Layout

            std::getline(ss,
 kStr,
 ',') &&
\end_layout

\begin_layout Plain Layout

            std::getline(ss,
 gStr)) {
\end_layout

\begin_layout Plain Layout

            try {
\end_layout

\begin_layout Plain Layout

                float k = std::stof(kStr);
\end_layout

\begin_layout Plain Layout

                float g = std::stof(gStr);
\end_layout

\begin_layout Plain Layout

                AddMineral(nome,
 k,
 g);
\end_layout

\begin_layout Plain Layout

            } catch (...) {
\end_layout

\begin_layout Plain Layout

                std::cerr << "[WARN] Erro ao interpretar linha:
 " << linha << "
\backslash
n";
\end_layout

\begin_layout Plain Layout

            }
\end_layout

\begin_layout Plain Layout

        }
\end_layout

\begin_layout Plain Layout

    }
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    file.close();
\end_layout

\begin_layout Plain Layout

}
