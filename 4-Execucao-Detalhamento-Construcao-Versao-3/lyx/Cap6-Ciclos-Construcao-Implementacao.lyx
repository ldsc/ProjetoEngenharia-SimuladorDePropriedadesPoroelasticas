\begin_layout Plain Layout

void CPlotManager::PlotVariationByMineral(const CMineralDatabase& db,
\end_layout

\begin_layout Plain Layout

                                        const std::string& principal,
\end_layout

\begin_layout Plain Layout

                                        const std::string& secundario,
\end_layout

\begin_layout Plain Layout

                                        bool displayOnScreen) {
\end_layout

\begin_layout Plain Layout

    if (!db.HasMineral(principal) || !db.HasMineral(secundario)) {
\end_layout

\begin_layout Plain Layout

        std::cerr << "[ERRO] Um ou ambos os minerais nao estao na base de dados.
\backslash
n";
\end_layout

\begin_layout Plain Layout

        return;
\end_layout

\begin_layout Plain Layout

    }
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    std::vector<double> perc,
 kV,
 kR,
 kH,
 gV,
 gR,
 gH;
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    for (int p = 0;
 p <= 100;
 p += 5) {
\end_layout

\begin_layout Plain Layout

        float fPri = 100.0f - p;
\end_layout

\begin_layout Plain Layout

        float fSec = p;
\end_layout

\begin_layout Plain Layout

        float kp = db.GetBulkModulus(principal),
 gp = db.GetShearModulus(principal);
\end_layout

\begin_layout Plain Layout

        float ks = db.GetBulkModulus(secundario),
 gs = db.GetShearModulus(secundario);
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

        float kv = (fPri * kp + fSec * ks) / 100.0f;
\end_layout

\begin_layout Plain Layout

        float gv = (fPri * gp + fSec * gs) / 100.0f;
\end_layout

\begin_layout Plain Layout

        float kr = 1.0f / ((fPri / 100.0f) / kp + (fSec / 100.0f) / ks);
\end_layout

\begin_layout Plain Layout

        float gr = 1.0f / ((fPri / 100.0f) / gp + (fSec / 100.0f) / gs);
\end_layout

\begin_layout Plain Layout

        float kh = (kv + kr) / 2.0f;
\end_layout

\begin_layout Plain Layout

        float gh = (gv + gr) / 2.0f;
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

        perc.push_back(fSec);
\end_layout

\begin_layout Plain Layout

        kV.push_back(kv);
 kR.push_back(kr);
 kH.push_back(kh);
\end_layout

\begin_layout Plain Layout

        gV.push_back(gv);
 gR.push_back(gr);
 gH.push_back(gh);
\end_layout

\begin_layout Plain Layout

    }
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout

    std::string base = "var_" + principal + "_vs_" + secundario;
